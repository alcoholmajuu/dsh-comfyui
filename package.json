{
  "name": "@local/dsh-comfyui",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "DSH ComfyUI Operator, Studio and self-hosted MCP/REST Gateway",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./studio": "./lib/studio.js",
    "./client": "./lib/client.js",
    "./bridge": "./lib/bridge-plugin.js"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "NOTICE",
    "gateway/app/*.py",
    "gateway/pyproject.toml",
    "gateway/.env.example",
    "gateway/README.md",
    "gateway/NOTICE",
    "gateway/uv.lock",
    "LICENSE",
    "src",
    "test",
    "gateway/tests/*.py",
    "config"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "sessions",
        "connection",
        "sidebarRight",
        "sidebarRightTabs"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "login": "node scripts/login.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "npm run test:plugin && npm run test:gateway",
    "test:plugin": "node --test test/*.test.mjs",
    "test:gateway": "node scripts/gateway.mjs test",
    "gateway": "node scripts/gateway.mjs start",
    "gateway:check": "node scripts/gateway.mjs check",
    "connection": "node scripts/connection.mjs",
    "verify:discovery": "node scripts/verify.mjs --discovery-only",
    "release:check": "node scripts/release.mjs check",
    "release:export": "node scripts/release.mjs export"
  },
  "dependencies": {
    "mcp-remote": "0.15.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "license": "MIT"
}
