# Cloudflare Access. Without a team domain and an application every request is refused.
# Leave CF_ACCESS_AUD empty to have the gateway look the application's AUD up from
# Cloudflare by GW_PUBLIC_HOSTNAME (it finds it once the Access application exists).
CF_ACCESS_TEAM_DOMAIN=your-team
CF_ACCESS_AUD=
GW_PUBLIC_HOSTNAME=comfy-mcp.example.com
# People allowed in (Access login email), comma separated
GW_OWNER_EMAILS=
# Access service tokens allowed in (their Client ID, "xxxx.access"), comma separated.
# "*" accepts any service token the Access application's own policy lets through.
GW_SERVICE_TOKEN_IDS=
# ComfyUI
COMFY_URL=http://127.0.0.1:8188
GW_PORT=8790
# Unload models from VRAM after this many idle minutes (0 = never)
GW_IDLE_FREE_MINUTES=15
# Where the text encoder runs: "default" (GPU, moved to RAM while sampling) or "cpu"
COMFY_ENCODER_DEVICE=default
# Saved workflows (default: workflows/ next to the app)
GW_WORKFLOW_DIR=

# Optional: built-in Qwen workflows require these installed model filenames.
# Generic run_workflow accepts other installed models and nodes.
COMFY_UNET=qwen-image-2.1-UC-BF16.gguf
COMFY_TEXT_ENCODER=qwen3vl_8b_bf16.safetensors
COMFY_VAE=qwen_image_2.1_vae_bf16.safetensors
